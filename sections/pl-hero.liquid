{{ 'purelane-tokens.css' | asset_url | stylesheet_tag }}
{{ 'pl-hero.css' | asset_url | stylesheet_tag }}
<script src="{{ 'pl-hero-carousel.js' | asset_url }}" defer></script>

{%- assign slide_blocks = section.blocks | where: 'type', 'slide' -%}
{%- assign badge_blocks = section.blocks | where: 'type', 'badge' -%}

<section class="pl-hero" aria-labelledby="pl-hero-title-{{ section.id }}">
  <div class="pl-hero__bg" aria-hidden="true"></div>
  <div class="pl-hero__grid pl-wrap">
    <div class="pl-hero__copy">
      <h1 id="pl-hero-title-{{ section.id }}" class="pl-hero__h1 pl-h2--no-rule">
        {{ section.settings.headline_a }}<br>
        {{ section.settings.headline_b }}<br>
        <span class="pl-hero__accent">{{ section.settings.headline_c }}</span>
      </h1>
      {% if section.settings.lede != blank %}
        <p class="pl-hero__lede">{{ section.settings.lede }}</p>
      {% endif %}
      <div class="pl-hero__cta">
        {% if section.settings.cta1_text != blank %}
          <a class="pl-btn pl-btn--primary" href="{{ section.settings.cta1_url | default: '#' }}">{{ section.settings.cta1_text }} →</a>
        {% endif %}
        {% if section.settings.cta2_text != blank %}
          <a class="pl-btn pl-btn--ghost" href="{{ section.settings.cta2_url | default: '#' }}">{{ section.settings.cta2_text }}</a>
        {% endif %}
      </div>
      {% if badge_blocks.size > 0 %}
        <ul class="pl-hero__badges">
          {%- for block in badge_blocks -%}
            <li {{ block.shopify_attributes }}><span class="pl-hero__badge">{{ block.settings.label }}</span></li>
          {%- endfor -%}
        </ul>
      {% endif %}
    </div>

    <div class="pl-hero__prod">
      <div class="pl-hero__stage" role="region" aria-roledescription="carousel" aria-label="Hero products">
        {%- if slide_blocks.size > 0 -%}
          {%- for slide in slide_blocks -%}
            {%- assign count = 0 -%}
            {%- for i in (1..3) -%}
              {%- assign pkey = 'product_' | append: i -%}
              {%- if slide.settings[pkey] != blank -%}{%- assign count = count | plus: 1 -%}{%- endif -%}
            {%- endfor -%}
            <div class="pl-hero__slide{% if forloop.first %} is-on{% endif %}" data-count="{{ count }}" {{ slide.shopify_attributes }}>
              {%- for i in (1..3) -%}
                {%- assign pkey = 'product_' | append: i -%}
                {%- assign p = slide.settings[pkey] -%}
                {%- if p != blank -%}
                  {%- if p.featured_media -%}
                    {{ p.featured_media | image_url: width: 600 | image_tag:
                         width: 600, height: 900,
                         fetchpriority: 'high',
                         loading: 'eager',
                         class: 'pl-hero__slide-img',
                         alt: p.title }}
                  {%- else -%}
                    <span class="pl-hero__slide-img pl-hero__slide-img--empty" aria-hidden="true"></span>
                  {%- endif -%}
                {%- endif -%}
              {%- endfor -%}
              {% if slide.settings.tag_label != blank or slide.settings.tag_price != blank %}
                <div class="pl-hero__tag">
                  {% if slide.settings.tag_label != blank %}<span class="pl-hero__tag-lbl">{{ slide.settings.tag_label }}</span>{% endif %}
                  <span class="pl-hero__tag-val">
                    {% if slide.settings.tag_price != blank %}<strong>{{ slide.settings.tag_price }}</strong>{% endif %}
                    {% if slide.settings.tag_compare != blank %}<s>{{ slide.settings.tag_compare }}</s>{% endif %}
                  </span>
                  {% if slide.settings.tag_save != blank %}<span class="pl-hero__tag-cut">{{ slide.settings.tag_save }}</span>{% endif %}
                </div>
              {% endif %}
            </div>
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Fallback: legacy single-product setup {%- endcomment -%}
          {%- assign hp = section.settings.hero_product -%}
          <div class="pl-hero__slide is-on" data-count="1">
            {% if hp != blank and hp.featured_media %}
              {{ hp.featured_media | image_url: width: 800 | image_tag:
                   width: 800, height: 1200, fetchpriority:'high',
                   class:'pl-hero__slide-img', alt: hp.title }}
            {% else %}
              <span class="pl-hero__slide-img pl-hero__slide-img--empty" aria-hidden="true"></span>
            {% endif %}
            {% if section.settings.tag_label != blank %}
              <div class="pl-hero__tag">
                <span class="pl-hero__tag-lbl">{{ section.settings.tag_label }}</span>
                <span class="pl-hero__tag-val">
                  <strong>{{ section.settings.tag_price }}</strong>
                  {% if section.settings.tag_compare != blank %}<s>{{ section.settings.tag_compare }}</s>{% endif %}
                </span>
                {% if section.settings.tag_save != blank %}<span class="pl-hero__tag-cut">{{ section.settings.tag_save }}</span>{% endif %}
              </div>
            {% endif %}
          </div>
        {%- endif -%}
      </div>
      {% if slide_blocks.size > 1 %}
        <div class="pl-hero__dots" role="tablist" aria-label="Choose a hero slide">
          {%- for slide in slide_blocks -%}
            <button type="button"{% if forloop.first %} class="is-on"{% endif %} aria-label="Show {{ forloop.index }} of {{ slide_blocks.size }}"></button>
          {%- endfor -%}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name":"Purelane — Hero",
  "tag":"section",
  "class":"pl-section-wrap",
  "settings":[
    {"type":"header","content":"Headline"},
    {"type":"text","id":"headline_a","label":"Headline line 1","default":"Clean"},
    {"type":"text","id":"headline_b","label":"Headline line 2","default":"That"},
    {"type":"text","id":"headline_c","label":"Accent word","default":"Lasts"},
    {"type":"textarea","id":"lede","label":"Lede","default":"Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it."},
    {"type":"header","content":"Buttons"},
    {"type":"text","id":"cta1_text","label":"Primary CTA text","default":"Shop now"},
    {"type":"url","id":"cta1_url","label":"Primary CTA link"},
    {"type":"text","id":"cta2_text","label":"Secondary CTA text","default":"How it works"},
    {"type":"url","id":"cta2_url","label":"Secondary CTA link"},
    {"type":"header","content":"Fallback (used only if no slide blocks are added)"},
    {"type":"product","id":"hero_product","label":"Legacy single product"},
    {"type":"text","id":"tag_label","label":"Legacy tag label","default":"Single bottle"},
    {"type":"text","id":"tag_price","label":"Legacy tag price","default":"₹200"},
    {"type":"text","id":"tag_compare","label":"Legacy tag compare","default":"₹299"},
    {"type":"text","id":"tag_save","label":"Legacy tag save","default":"33% off"}
  ],
  "blocks":[
    {"type":"slide","name":"Slide","limit":4,"settings":[
      {"type":"product","id":"product_1","label":"Product 1"},
      {"type":"product","id":"product_2","label":"Product 2 (optional)"},
      {"type":"product","id":"product_3","label":"Product 3 (optional)"},
      {"type":"text","id":"tag_label","label":"Tag label","default":"Single bottle"},
      {"type":"text","id":"tag_price","label":"Tag price","default":"₹200"},
      {"type":"text","id":"tag_compare","label":"Tag compare-at","default":"₹299"},
      {"type":"text","id":"tag_save","label":"Tag save copy","default":"33% off"}
    ]},
    {"type":"badge","name":"Badge","limit":3,"settings":[
      {"type":"text","id":"label","label":"Badge text","default":"Plant powered"}
    ]}
  ],
  "max_blocks":8,
  "presets":[{
    "name":"Purelane — Hero",
    "blocks":[
      {"type":"slide","settings":{"tag_label":"Single bottle","tag_price":"₹200","tag_compare":"₹299","tag_save":"33% off"}},
      {"type":"slide","settings":{"tag_label":"Any 2 products","tag_price":"₹349","tag_compare":"₹598","tag_save":"Save ₹249"}},
      {"type":"slide","settings":{"tag_label":"Any 3 products","tag_price":"₹499","tag_compare":"₹897","tag_save":"Save ₹398"}},
      {"type":"badge","settings":{"label":"Plant powered"}},
      {"type":"badge","settings":{"label":"Safe for kids & pets"}},
      {"type":"badge","settings":{"label":"Zero harsh chemicals"}}
    ]
  }]
}
{% endschema %}
